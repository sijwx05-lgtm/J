local RejoinEvents = {}

pcall(function()
    local events = ReplicatedStorage:FindFirstChild("Events")

    if events then
        local request = events:FindFirstChild("RequestRejoin")
        local failed = events:FindFirstChild("RejoinFailed")

        if request then
            RejoinEvents[request] = true
        end

        if failed then
            RejoinEvents[failed] = true
        end
    end
end)

if hookmetamethod and getnamecallmethod and newcclosure then
    local oldNamecall

    oldNamecall = hookmetamethod(
        game,
        "__namecall",
        newcclosure(function(self, ...)
            if RejoinEvents[self]
                and getnamecallmethod() == "FireServer" then

                warn("[ANTI REJOIN] Blocked:", self.Name)
                return nil
            end

            return oldNamecall(self, ...)
        end)
    )

    print("[ANTI REJOIN] Loaded")
else
    warn("[ANTI REJOIN] Executor does not support hookmetamethod")
end

