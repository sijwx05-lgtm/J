--==================================================
-- SHARED DROP SCANNER
--==================================================

local function getDrops(blacklist)
    local drops = {}
    local seen = {}

    for _, obj in ipairs(Folder:GetDescendants()) do
        if obj.Name == "PointDrop"
            and not seen[obj]
            and not blacklist[obj] then

            seen[obj] = true

            local pos = getPosition(obj)

            if pos then
                table.insert(drops, {
                    Object = obj,
                    Position = pos
                })
            end
        end
    end

    return drops
end

local function findNearest(root, blacklist)
    local nearest = nil
    local shortest = math.huge

    for _, drop in ipairs(getDrops(blacklist)) do
        local distance =
            (root.Position - drop.Position).Magnitude

        if distance < shortest then
            shortest = distance
            nearest = drop.Object
        end
    end

    return nearest
end

--==================================================
-- V3 SETTINGS
--==================================================

local V3_ARRIVE_DISTANCE = 5
local V3_RAY_DISTANCE = 14
local V3_STUCK_TIMEOUT = 0.9
local V3_STRAIGHT_TIMEOUT = 2.5
local V3_WAYPOINT_TIMEOUT = 4

local function V3_hasObstacle(root, targetPosition, target)
    local direction = targetPosition - root.Position

    local horizontal = Vector3.new(
        direction.X, 0, direction.Z
    )

    if horizontal.Magnitude < 1 then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local exclude = {Player.Character}
    if target then
        table.insert(exclude, target)
    end

    params.FilterDescendantsInstances = exclude
    params.RespectCanCollide = true

    local distance = math.min(
        horizontal.Magnitude,
        V3_RAY_DISTANCE
    )

    for _, height in ipairs({1, 3, 5}) do
        local result = Workspace:Raycast(
            root.Position + Vector3.new(0, height, 0),
            horizontal.Unit * distance,
            params
        )

        if result then
            return true
        end
    end

    return false
end

local function V3_computePath(root, targetPosition)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentJumpHeight = 10,
        AgentCanClimb = true,
        AgentMaxSlope = 45,
        WaypointSpacing = 4
    })

    local success = pcall(function()
        path:ComputeAsync(root.Position, targetPosition)
    end)

    if success and path.Status == Enum.PathStatus.Success then
        return path
    end

    return nil
end

local function V3_isStuck(root, lastPosition, lastProgress)
    if (root.Position - lastPosition).Magnitude > 0.8 then
        return false
    end

    return os.clock() - lastProgress > V3_STUCK_TIMEOUT
end

local function V3_walkStraight(humanoid, root, target)
    local position = getPosition(target)
    if not position then return false end

    humanoid:MoveTo(position)

    local start = os.clock()
    local lastPosition = root.Position
    local lastProgress = os.clock()

    while V3Enabled and target.Parent do
        position = getPosition(target)
        if not position then return false end

        if (root.Position - position).Magnitude
            <= V3_ARRIVE_DISTANCE then
            return true
        end

        if humanoid.Sit then
            humanoid.Sit = false
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end

        if (root.Position - lastPosition).Magnitude > 0.8 then
            lastPosition = root.Position
            lastProgress = os.clock()
        end

        if V3_isStuck(root, lastPosition, lastProgress) then
            return false
        end

        if os.clock() - start > V3_STRAIGHT_TIMEOUT then
            return false
        end

        task.wait(0.1)
    end

    return false
end

local function V3_walkPath(humanoid, root, target)
    local targetPosition = getPosition(target)
    if not targetPosition then return false end

    local path = V3_computePath(root, targetPosition)
    if not path then return false end

    local blocked = false
    local currentWaypoint = 0

    local connection = path.Blocked:Connect(function(index)
        if index >= currentWaypoint then
            blocked = true
        end
    end)

    for index, waypoint in ipairs(path:GetWaypoints()) do
        if not V3Enabled or blocked or not target.Parent then
            break
        end

        currentWaypoint = index

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        local start = os.clock()
        local lastPosition = root.Position
        local lastProgress = os.clock()
        local reached = false

        while V3Enabled and not blocked and target.Parent do
            if (root.Position - waypoint.Position).Magnitude <= 3 then
                reached = true
                break
            end

            if humanoid.Sit then
                humanoid.Sit = false
                humanoid:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end

            if (root.Position - lastPosition).Magnitude > 0.8 then
                lastPosition = root.Position
                lastProgress = os.clock()
            end

            if V3_isStuck(root, lastPosition, lastProgress)
                or os.clock() - start > V3_WAYPOINT_TIMEOUT then
                blocked = true
                break
            end

            task.wait(0.1)
        end

        if not reached then
            blocked = true
            break
        end
    end

    connection:Disconnect()

    if not V3Enabled then return false end

    local finalPosition = getPosition(target)

    return finalPosition ~= nil
        and (root.Position - finalPosition).Magnitude
            <= V3_ARRIVE_DISTANCE
end

local function V3_moveToDrop(humanoid, root, target)
    local position = getPosition(target)
    if not position then return false end

    if V3_hasObstacle(root, position, target) then
        return V3_walkPath(humanoid, root, target)
    end

    local success = V3_walkStraight(humanoid, root, target)
    if success then return true end

    if not V3Enabled or not target.Parent then
        return false
    end

    return V3_walkPath(humanoid, root, target)
end

--==================================================
-- V4 SETTINGS
--==================================================

local V4_ARRIVE_DISTANCE = 5
local V4_BYPASS_MARGIN = 6
local V4_STUCK_TIMEOUT = 1.5
local V4_WAYPOINT_TIMEOUT = 5

local function V4_makeRayParams(target)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local exclude = {Player.Character}
    if target then
        table.insert(exclude, target)
    end

    params.FilterDescendantsInstances = exclude
    params.RespectCanCollide = true

    return params
end

local function V4_detectObstacle(root, targetPosition, target)
    local direction = targetPosition - root.Position

    local horizontal = Vector3.new(
        direction.X, 0, direction.Z
    )

    if horizontal.Magnitude < 1 then
        return nil
    end

    local params = V4_makeRayParams(target)

    for _, height in ipairs({1, 3, 5}) do
        local result = Workspace:Raycast(
            root.Position + Vector3.new(0, height, 0),
            horizontal.Unit * math.min(horizontal.Magnitude, 16),
            params
        )

        if result then
            return result.Instance
        end
    end

    return nil
end

local function V4_getObstacleRoot(part)
    local current = part

    while current
        and current ~= Workspace
        and current.Parent ~= Islands do

        if current:IsA("Model") and current.Parent then
            return current
        end

        current = current.Parent
    end

    return part
end

local function V4_getGroundPosition(x, z, target)
    local params = V4_makeRayParams(target)

    local result = Workspace:Raycast(
        Vector3.new(x, 500, z),
        Vector3.new(0, -1000, 0),
        params
    )

    if result and result.Instance.CanCollide then
        return result.Position + Vector3.new(0, 2.5, 0)
    end

    return nil
end

local function V4_computePath(root, destination)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentJumpHeight = 10,
        AgentCanClimb = true,
        AgentMaxSlope = 45,
        WaypointSpacing = 4
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, destination)
    end)

    if ok and path.Status == Enum.PathStatus.Success then
        return path
    end

    return nil
end

local function V4_walkPath(humanoid, root, destination, target)
    local path = V4_computePath(root, destination)
    if not path then return false end

    local blocked = false
    local currentIndex = 0

    local connection = path.Blocked:Connect(function(index)
        if index >= currentIndex then
            blocked = true
        end
    end)

    for index, waypoint in ipairs(path:GetWaypoints()) do
        if not V4Enabled or blocked then
            break
        end

        currentIndex = index

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        local start = os.clock()
        local lastPosition = root.Position
        local lastProgress = os.clock()
        local reached = false

        while V4Enabled and not blocked do
            if target and not target.Parent then
                break
            end

            if (root.Position - waypoint.Position).Magnitude <= 3 then
                reached = true
                break
            end

            if (root.Position - lastPosition).Magnitude > 0.7 then
                lastPosition = root.Position
                lastProgress = os.clock()
            end

            if os.clock() - lastProgress > V4_STUCK_TIMEOUT
                or os.clock() - start > V4_WAYPOINT_TIMEOUT then
                blocked = true
                break
            end

            if humanoid.Sit then
                humanoid.Sit = false
                humanoid:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end

            task.wait(0.1)
        end

        if not reached then
            blocked = true
            break
        end
    end

    connection:Disconnect()
    return not blocked
end

local function V4_getBypassPoints(obstacle, root, targetPosition, target)
    local points = {}

    local ok, boxCF, boxSize = pcall(function()
        if obstacle:IsA("Model") then
            return obstacle:GetBoundingBox()
        elseif obstacle:IsA("BasePart") then
            return obstacle.CFrame, obstacle.Size
        end
    end)

    if not ok or not boxCF or not boxSize then
        return points
    end

    local center = boxCF.Position
    local halfX = boxSize.X / 2 + V4_BYPASS_MARGIN
    local halfZ = boxSize.Z / 2 + V4_BYPASS_MARGIN

    local offsets = {
        Vector3.new(-halfX, 0, -halfZ),
        Vector3.new( halfX, 0, -halfZ),
        Vector3.new(-halfX, 0,  halfZ),
        Vector3.new( halfX, 0,  halfZ),
        Vector3.new(-halfX, 0, 0),
        Vector3.new( halfX, 0, 0),
        Vector3.new(0, 0, -halfZ),
        Vector3.new(0, 0,  halfZ)
    }

    for _, offset in ipairs(offsets) do
        local worldPoint = center + offset

        local ground = V4_getGroundPosition(
            worldPoint.X,
            worldPoint.Z,
            target
        )

        if ground then
            local distanceFromRoot =
                (root.Position - ground).Magnitude

            local distanceToTarget =
                (targetPosition - ground).Magnitude

            table.insert(points, {
                Position = ground,
                Score = distanceFromRoot + distanceToTarget
            })
        end
    end

    table.sort(points, function(a, b)
        return a.Score < b.Score
    end)

    return points
end

local function V4_islandBypass(humanoid, root, target, obstacle)
    local targetPosition = getPosition(target)
    if not targetPosition then return false end

    local obstacleRoot = V4_getObstacleRoot(obstacle)

    local candidates = V4_getBypassPoints(
        obstacleRoot,
        root,
        targetPosition,
        target
    )

    if #candidates == 0 then
        return false
    end

    for index, candidate in ipairs(candidates) do
        if not V4Enabled then
            return false
        end

        local success = V4_walkPath(
            humanoid,
            root,
            candidate.Position,
            target
        )

        if success then
            local newPosition = getPosition(target)

            if newPosition then
                return true
            end
        end
    end

    return false
end

local function V4_tryJumpToTarget(humanoid, root, target)
    local position = getPosition(target)
    if not position then return false end

    humanoid.Jump = true
    humanoid:MoveTo(position)

    local start = os.clock()

    while V4Enabled and target.Parent
        and os.clock() - start < 2.5 do

        position = getPosition(target)
        if not position then return false end

        if (root.Position - position).Magnitude
            <= V4_ARRIVE_DISTANCE then
            return true
        end

        task.wait(0.1)
    end

    return false
end

local function V4_moveToDrop(humanoid, root, target)
    local position = getPosition(target)
    if not position then return false end

    local obstacle = V4_detectObstacle(root, position, target)

    if obstacle then
        local bypassSuccess = V4_islandBypass(
            humanoid,
            root,
            target,
            obstacle
        )

        if not V4Enabled then return false end

        position = getPosition(target)
        if not position then return false end

        obstacle = V4_detectObstacle(root, position, target)

        if not obstacle then
            return true
        end

        if position.Y > root.Position.Y + 2 then
            if V4_tryJumpToTarget(humanoid, root, target) then
                return true
            end
        end

        return bypassSuccess
    end

    humanoid:MoveTo(position)

    local start = os.clock()
    local lastPosition = root.Position
    local lastProgress = os.clock()

    while V4Enabled and target.Parent do
        position = getPosition(target)
        if not position then return false end

        if (root.Position - position).Magnitude
            <= V4_ARRIVE_DISTANCE then
            return true
        end

        if (root.Position - lastPosition).Magnitude > 0.7 then
            lastPosition = root.Position
            lastProgress = os.clock()
        end

        if humanoid.Sit then
            humanoid.Sit = false
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end

        if os.clock() - lastProgress > V4_STUCK_TIMEOUT
            or os.clock() - start > V4_WAYPOINT_TIMEOUT then

            local hit = V4_detectObstacle(root, position, target)

            if hit then
                return V4_islandBypass(
                    humanoid,
                    root,
                    target,
                    hit
                )
            end

            return V4_walkPath(
                humanoid,
                root,
                position,
                target
            )
        end

        task.wait(0.1)
    end

    return false
end

