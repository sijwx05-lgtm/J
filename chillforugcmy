task.spawn(function()
    while gui.Parent do
        task.wait(0.15)

        if not V4Enabled then
            continue
        end

        local char, humanoid, root = getCharacter()

        if not char then
            continue
        end

        if humanoid.Sit then
            humanoid.Sit = false
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end

        if not V4Target
            or not V4Target.Parent
            or not getPosition(V4Target)
            or V4Blacklist[V4Target] then

            V4Target = findNearest(root, V4Blacklist)
        end

        if not V4Target then
            continue
        end

        local target = V4Target
        local position = getPosition(target)

        if position then
            if (root.Position - position).Magnitude
                <= V4_ARRIVE_DISTANCE then

                V4Blacklist[target] = true
                V4Target = nil
            else
                local success = V4_moveToDrop(
                    humanoid,
                    root,
                    target
                )

                if not V4Enabled then
                    continue
                end

                if not target.Parent then
                    V4Target = nil
                elseif success then
                    local finalPosition = getPosition(target)

                    if finalPosition and
                        (root.Position - finalPosition).Magnitude
                        <= V4_ARRIVE_DISTANCE then

                        V4Blacklist[target] = true
                        V4Target = nil
                    else
                        task.wait(0.2)
                    end
                else
                    task.wait(0.4)
                end
            end
        else
            V4Target = nil
        end
    end
end)

