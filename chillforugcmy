task.spawn(function()
    while gui.Parent do
        task.wait(0.15)

        if not V3Enabled then
            continue
        end

        local char, humanoid, root = getCharacter()

        if not char then
            continue
        end

        if humanoid.Sit then
            humanoid.Sit = false
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end

        if not V3Target
            or not V3Target.Parent
            or not getPosition(V3Target)
            or V3Blacklist[V3Target] then

            V3Target = findNearest(root, V3Blacklist)
        end

        if not V3Target then
            continue
        end

        local target = V3Target
        local position = getPosition(target)

        if position then
            if (root.Position - position).Magnitude
                <= V3_ARRIVE_DISTANCE then

                V3Blacklist[target] = true
                V3Target = nil
            else
                local success = V3_moveToDrop(
                    humanoid,
                    root,
                    target
                )

                if not V3Enabled then
                    continue
                end

                if not target.Parent then
                    V3Target = nil
                elseif success then
                    local finalPosition = getPosition(target)

                    if finalPosition and
                        (root.Position - finalPosition).Magnitude
                        <= V3_ARRIVE_DISTANCE then

                        V3Blacklist[target] = true
                        V3Target = nil
                    end
                else
                    task.wait(0.25)
                end
            end
        else
            V3Target = nil
        end
    end
end)

