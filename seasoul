--========================================
--  TELEPORT
--========================================

local function teleportTo(index)
    local name = string.format("Halloween%02d", index)

    local target = workspace:FindFirstChild(name, true)

    if not target then
        selectedLabel.Text = name .. " tidak ditemukan"
        return false
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false
    end

    if target:IsA("Model") then
        root.CFrame = target:GetPivot() + Vector3.new(0, 3, 0)
        selectedLabel.Text = "Target: " .. name
        return true

    elseif target:IsA("BasePart") then
        root.CFrame = target.CFrame + Vector3.new(0, 3, 0)
        selectedLabel.Text = "Target: " .. name
        return true
    end

    selectedLabel.Text = name .. " bukan target valid"
    return false
end

