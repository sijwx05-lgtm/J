    if running then
        autoButton.Text = "AUTO TELEPORT: ON"
        autoButton.BackgroundColor3 = Color3.fromRGB(25, 150, 65)

        task.spawn(function()
            while running do
                teleportTo(currentIndex)

                currentIndex += 1

                if currentIndex > 48 then
                    currentIndex = 1
                end

                task.wait(interval)
            end
        end)

    else
        autoButton.Text = "AUTO TELEPORT: OFF"
        autoButton.BackgroundColor3 = Color3.fromRGB(150, 35, 35)
    end
end)

